    <script>
    // Global error listener to prevent and suppress unhandled third-party/DevTools/web-vitals startTime errors
    window.addEventListener('error', function(event) {
      if (event && event.message && event.message.includes('startTime')) {
        event.preventDefault();
        event.stopImmediatePropagation();
        return true;
      }
    }, true);

    const API_BASE_URL = 'http://127.0.0.1:8000';
    
    let rawEmployees = [];
    let rawEmployeeSkills = [];
    let rawProjects = [];
    let rawTasks = [];
    let rawSkills = [];
    let rawAssignments = [];

    let processedWorkers = [];
    let processedProjects = [];
    let processedTasks = [];

    // In-memory project team allocation mapping: { [projectId]: [workerId, ...] }
    let projectTeams = {};
    let editingWorkerId = null;
    
    let currentDashboardFilter = 'all';
    let currentProjectsFilter = 'all';
    let currentTasksFilter = 'all';
    let activeView = 'dashboard';
    let selectedWorkerId = null;
    let selectedProjectId = null;
    let selectedTeamSkills = new Set();

    document.addEventListener('DOMContentLoaded', () => {
      initTimeAndGreeting();
      fetchDashboardData();
      initKeyboardShortcuts();

      const hash = window.location.hash.replace('#', '').toLowerCase();
      if (['workers', 'projects', 'tasks', 'ai-assignment', 'attendance', 'reports'].includes(hash)) {
        navigateView(hash);
      } else {
        navigateView('dashboard');
      }

      window.addEventListener('hashchange', () => {
        const currentHash = window.location.hash.replace('#', '').toLowerCase();
        if (['dashboard', 'workers', 'projects', 'tasks', 'ai-assignment', 'attendance', 'reports'].includes(currentHash)) {
          navigateView(currentHash);
        }
      });
    });

    function navigateView(viewName, e) {
      if (e) e.preventDefault();
      activeView = viewName;
      closeProjectDetail();

      const navLinks = document.querySelectorAll('.nav-section .nav-item');
      navLinks.forEach(link => {
        const targetView = link.getAttribute('data-view');
        if (targetView === viewName) {
          link.classList.add('active');
        } else if (targetView) {
          link.classList.remove('active');
        }
      });

      const allViews = document.querySelectorAll('.view-section');
      allViews.forEach(sec => sec.classList.remove('active'));

      const targetSec = document.getElementById(`view-${viewName}`);
      if (targetSec) {
        targetSec.classList.add('active');
        window.location.hash = viewName;
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function initTimeAndGreeting() {
      const now = new Date();
      const options = { weekday: 'long', year: 'numeric', month: 'short', day: '2-digit' };
      const dateEl = document.getElementById('current-date-str');
      if (dateEl) dateEl.textContent = now.toLocaleDateString('en-US', options);

      const hour = now.getHours();
      let greeting = 'Good Morning';
      if (hour >= 12 && hour < 17) greeting = 'Good Afternoon';
      else if (hour >= 17 || hour < 5) greeting = 'Good Evening';
      const greetingEl = document.getElementById('greeting-text');
      if (greetingEl) greetingEl.textContent = greeting;
    }

    async function fetchDashboardData() {
      updateTelemetryStatus('connecting', 'API: CONNECTING', '--');
      const startTime = performance.now();

      try {
        const timeoutPromise = new Promise((_, reject) => setTimeout(() => reject(new Error('Network timeout')), 4000));

        const fetchEmployees = fetch(`${API_BASE_URL}/employees`, { cache: 'no-store' }).then(r => r.ok ? r.json() : []);
        const fetchSkills = fetch(`${API_BASE_URL}/employee_skills`, { cache: 'no-store' }).then(r => r.ok ? r.json() : []).catch(() => []);
        const fetchProjects = fetch(`${API_BASE_URL}/projects`, { cache: 'no-store' }).then(r => r.ok ? r.json() : []);
        const fetchTasks = fetch(`${API_BASE_URL}/tasks`, { cache: 'no-store' }).then(r => r.ok ? r.json() : []).catch(() => []);
        const fetchSkillTaxonomy = fetch(`${API_BASE_URL}/skills`, { cache: 'no-store' }).then(r => r.ok ? r.json() : []).catch(() => []);
        const fetchAssignments = fetch(`${API_BASE_URL}/assignments`, { cache: 'no-store' }).then(r => r.ok ? r.json() : []).catch(() => []);

        const [empData, skillsData, prjData, tasksData, skillTaxData, assignData] = await Promise.race([
          Promise.all([fetchEmployees, fetchSkills, fetchProjects, fetchTasks, fetchSkillTaxonomy, fetchAssignments]),
          timeoutPromise
        ]);

        const latency = Math.round(performance.now() - startTime);

        // CLEAN SLATE: ONLY show what comes back from the API, NO fallback synthetic mock workers or projects!
        rawEmployees = Array.isArray(empData) ? empData : (empData && empData.employees ? empData.employees : []);
        rawEmployeeSkills = Array.isArray(skillsData) ? skillsData : (skillsData && skillsData.skills ? skillsData.skills : []);
        rawProjects = Array.isArray(prjData) ? prjData : (prjData && prjData.projects ? prjData.projects : []);
        rawTasks = Array.isArray(tasksData) ? tasksData : (tasksData && tasksData.tasks ? tasksData.tasks : []);
        rawSkills = Array.isArray(skillTaxData) ? skillTaxData : [];
        rawAssignments = Array.isArray(assignData) ? assignData : [];

        document.getElementById('offline-alert')?.classList.remove('visible');
        updateTelemetryStatus('online', 'API: CONNECTED', `${latency} ms`);

        processAndRenderAll();

      } catch (err) {
        console.warn('API at', API_BASE_URL, 'offline or error:', err.message);
        document.getElementById('offline-alert')?.classList.add('visible');
        updateTelemetryStatus('offline', 'OFFLINE', '0 ms');

        // CLEAN SLATE: If backend is offline or empty, do NOT load synthetic mock workers or projects
        rawEmployees = [];
        rawEmployeeSkills = [];
        rawProjects = [];
        rawTasks = [];
        rawSkills = [];
        rawAssignments = [];

        processAndRenderAll();
      }
    }

    function updateTelemetryStatus(state, label, latency) {
      const dot = document.getElementById('telemetry-dot');
      const text = document.getElementById('telemetry-text');
      const lat = document.getElementById('telemetry-latency');

      if (dot) dot.className = 'pulse-dot' + (state === 'offline' ? ' offline' : '');
      if (text) text.textContent = label;
      if (lat) lat.textContent = latency;
    }

    function processAndRenderAll() {
      const skillMap = {};
      rawEmployeeSkills.forEach(item => {
        const empId = item.employee_id || item.emp_id || item.employeeId;
        if (!empId) return;
        if (!skillMap[empId]) skillMap[empId] = [];
        skillMap[empId].push({
          name: item.skill_name || item.skill || item.name || 'Core Skill',
          proficiency: item.skill_level || item.proficiency || item.level || 80
        });
      });

      // 1. Process Projects
      processedProjects = rawProjects.map((p, idx) => {
        const id = p.id || idx + 1;
        const code = `PRJ-${400 + id}`;
        const name = p.project_name || p.name || `Project ${id}`;
        const description = p.description || p.desc || 'Enterprise project';
        
        let statusRaw = (p.status || 'On Schedule').toLowerCase();
        let displayStatus = 'On Schedule';
        let statusKey = 'on-schedule';

        if (statusRaw.includes('complete') || statusRaw === 'done') {
          displayStatus = 'Completed';
          statusKey = 'completed';
        } else if (statusRaw.includes('delay') || statusRaw.includes('behind')) {
          displayStatus = 'Delayed';
          statusKey = 'delayed';
        } else if (statusRaw.includes('risk') || statusRaw === 'warning') {
          displayStatus = 'At Risk';
          statusKey = 'at-risk';
        } else if (statusRaw.includes('not started') || statusRaw === 'not_started') {
          displayStatus = 'Not Started';
          statusKey = 'on-schedule';
        }

        const priority = p.priority || 'Medium';
        const deadline = p.deadline || '2026-09-30';
        
        const projectTasks = rawTasks.filter(t => t.project_id === id);
        const totalTasks = projectTasks.length;
        const completedTasks = projectTasks.filter(t => (t.status || '').toLowerCase() === 'completed').length;
        let progress = (typeof p.progress === 'number') ? p.progress : (totalTasks > 0 ? Math.round((completedTasks / totalTasks) * 100) : 0);

        if (!projectTeams[id]) projectTeams[id] = [];

        return { id, code, name, description, status: displayStatus, statusKey, priority, deadline, progress, teamSize: 0, tasks: projectTasks, totalTasks, completedTasks };
      });

      // 2. Process Workers (Clean Slate: Real data only)
      processedWorkers = rawEmployees.map((emp, idx) => {
        const id = emp.employee_id || `EMP-${100 + (emp.id || idx + 1)}`;
        const dbId = emp.id || idx + 1;
        const name = emp.name || emp.full_name || `Employee ${idx + 1}`;
        const role = emp.role || emp.position || emp.job_title || 'Employee';
        const department = emp.department || emp.dept || 'General';
        
        let statusRaw = (emp.availability || emp.status || 'Available').toLowerCase().replace(/[\s-]/g, '_');
        let status = 'Available';
        let statusKey = 'available';

        if (statusRaw === 'on_project' || statusRaw === 'active' || statusRaw === 'busy' || statusRaw === 'assigned') {
          status = 'On Project';
          statusKey = 'on_project';
        } else if (statusRaw === 'on_leave' || statusRaw === 'leave' || statusRaw === 'pto') {
          status = 'On Leave';
          statusKey = 'on_leave';
        } else if (statusRaw === 'offline' || statusRaw === 'absent' || statusRaw === 'inactive') {
          status = 'Offline';
          statusKey = 'offline';
        } else {
          status = 'Available';
          statusKey = 'available';
        }

        // Real skills from employee_skills - NO synthetic fallback names or skills!
        let empSkills = skillMap[dbId] || skillMap[id] || [];
        if (empSkills.length === 0 && Array.isArray(emp.skills)) {
          empSkills = emp.skills.map(s => (typeof s === 'string' ? { name: s, proficiency: 80 } : { name: s.name || s.skill, proficiency: s.proficiency || 80 }));
        }

        // Current Project Assignment
        let currentProject = emp.current_project || null;
        for (const pid in projectTeams) {
          if (projectTeams[pid].includes(id) || projectTeams[pid].includes(dbId)) {
            const pObj = processedProjects.find(p => p.id == pid);
            if (pObj) {
              currentProject = pObj.name;
              status = 'On Project';
              statusKey = 'on_project';
            }
          }
        }

        if (currentProject) {
          const pObj = processedProjects.find(p => p.name.toLowerCase() === currentProject.toLowerCase());
          if (pObj && !projectTeams[pObj.id].includes(id)) {
            projectTeams[pObj.id].push(id);
          }
        }

        rawTasks.forEach(t => {
          if (t.assigned_employee_id === dbId || t.assigned_employee_id === id) {
            if (t.project_id && projectTeams[t.project_id] && !projectTeams[t.project_id].includes(id)) {
              projectTeams[t.project_id].push(id);
              const pObj = processedProjects.find(p => p.id === t.project_id);
              if (pObj && !currentProject) {
                currentProject = pObj.name;
                status = 'On Project';
                statusKey = 'on_project';
              }
            }
          }
        });

        let workload = (typeof emp.workload === 'number') ? emp.workload : (statusKey === 'on_project' ? 60 : 0);
        let performance = (typeof emp.performance_score === 'number' && emp.performance_score > 0) ? emp.performance_score : (typeof emp.performance === 'number' && emp.performance > 0 ? emp.performance : null);

        return { dbId, id, name, role, department, status, statusKey, skills: empSkills, currentProject, workload, performance, rfid_uid: emp.rfid_uid };
      });

      // Update project team sizes
      processedProjects.forEach(p => {
        const teamIds = projectTeams[p.id] || [];
        p.teamSize = teamIds.length;
      });

      // 3. Process Tasks
      processedTasks = rawTasks.map((t, idx) => {
        const id = t.id || idx + 1;
        const projectId = t.project_id || (processedProjects[0]?.id || 1);
        const projectObj = processedProjects.find(p => p.id === projectId);
        const projectName = projectObj ? projectObj.name : `Project ${projectId}`;
        const title = t.task_name || t.title || `Task #${id}`;
        const description = t.description || '';
        const skill = t.required_skill || 'General';
        const skillLevel = t.required_skill_level || 80;
        const priority = t.priority || 'Medium';
        const deadline = t.deadline || '2026-09-30';
        
        let assignedName = 'Unassigned';
        if (t.assigned_employee_id) {
          const assignedWorker = processedWorkers.find(w => w.dbId === t.assigned_employee_id || w.id === t.assigned_employee_id);
          if (assignedWorker) assignedName = assignedWorker.name;
        }

        let rawStatus = (t.status || 'Not Started').toLowerCase().replace(/[\s-]/g, '_');
        let status = 'Not Started';
        let statusKey = 'not_started';

        if (rawStatus === 'completed' || rawStatus === 'done') {
          status = 'Completed';
          statusKey = 'completed';
        } else if (rawStatus === 'in_progress' || rawStatus === 'active') {
          status = 'In Progress';
          statusKey = 'in_progress';
        } else if (rawStatus === 'blocked') {
          status = 'Blocked';
          statusKey = 'blocked';
        }

        return { id, projectId, projectName, title, description, skill, skillLevel, priority, deadline, assignedEmployeeId: t.assigned_employee_id, assignedName, status, statusKey };
      });

      renderDashboardFromData(processedWorkers, processedProjects);
      populateWorkerDropdowns(processedWorkers);
      applyWorkerFilters();
      updateProjectTabCounts(processedProjects);
      applyProjectsFilter();
      updateTasksTabCounts(processedTasks);
      applyTasksFilter();
      initAiAssignmentDropdowns();
      applyAttendanceFilter();
      renderReportsView();
      renderDynamicActivityFeed();
    }

    function renderDashboardFromData(workers, projects) {
      const totalWorkers = workers.length;
      let availableCount = 0;
      let onProjectCount = 0;
      let onLeaveCount = 0;

      workers.forEach(w => {
        if (w.statusKey === 'available') availableCount++;
        else if (w.statusKey === 'on_project') onProjectCount++;
        else if (w.statusKey === 'on_leave') onLeaveCount++;
      });

      const presentCount = Math.max(0, totalWorkers - onLeaveCount);
      const presentPct = totalWorkers > 0 ? Math.round((presentCount / totalWorkers) * 100) : 0;
      const availPct = totalWorkers > 0 ? Math.round((availableCount / totalWorkers) * 100) : 0;
      const deployPct = totalWorkers > 0 ? Math.round((onProjectCount / totalWorkers) * 100) : 0;

      const activeProjectsCount = projects.filter(p => p.statusKey !== 'completed').length;
      const atRiskCount = projects.filter(p => p.statusKey === 'at-risk' || p.statusKey === 'delayed').length;
      const totalPendingTasks = processedTasks.filter(t => t.statusKey !== 'completed').length;

      animateCount('kpi-total-workers', totalWorkers);
      animateCount('kpi-available-workers', availableCount);
      animateCount('kpi-on-project-workers', onProjectCount);
      animateCount('kpi-on-leave-workers', onLeaveCount);
      animateCount('kpi-active-projects', activeProjectsCount);
      animateCount('kpi-pending-tasks', totalPendingTasks);
      animateCount('kpi-at-risk-projects', atRiskCount);
      animateCount('kpi-present-today', presentCount);

      const kpiAvail = document.getElementById('kpi-avail-pct');
      const kpiDeploy = document.getElementById('kpi-deployed-pct');
      const kpiPresent = document.getElementById('kpi-present-pct');
      if (kpiAvail) kpiAvail.textContent = `${availPct}%`;
      if (kpiDeploy) kpiDeploy.textContent = `${deployPct}%`;
      if (kpiPresent) kpiPresent.textContent = `${presentPct}%`;

      renderDashboardProjectsTable(projects);
      generateAndRenderAIInsights(workers, projects, availableCount, totalWorkers);
    }

