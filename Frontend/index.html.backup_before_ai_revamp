    }

    function clearAllFieldErrors() {
      ['new-emp-id', 'new-emp-name', 'new-emp-dept', 'new-emp-role'].forEach(clearFieldError);
    }

    

    async function handleSaveWorker(e) {
      e.preventDefault();
      clearAllFieldErrors();
      const errorBanner = document.getElementById('modal-error-banner');
      const errorText = document.getElementById('modal-error-text');
      if (errorBanner) errorBanner.classList.remove('visible');

      const empId = document.getElementById('new-emp-id')?.value.trim();
      const rfid = document.getElementById('new-emp-rfid')?.value.trim() || `RF${Math.floor(Math.random()*900)+100}`;
      const name = document.getElementById('new-emp-name')?.value.trim();
      const dept = document.getElementById('new-emp-dept')?.value.trim();
      const role = document.getElementById('new-emp-role')?.value.trim();
      const avail = document.getElementById('new-emp-avail')?.value || 'Available';

      let hasError = false;
      if (!empId) {
        document.getElementById('new-emp-id')?.classList.add('invalid');
        document.getElementById('err-new-emp-id')?.classList.add('visible');
        hasError = true;
      }
      if (!name) {
        document.getElementById('new-emp-name')?.classList.add('invalid');
        document.getElementById('err-new-emp-name')?.classList.add('visible');
        hasError = true;
      }
      if (!dept) {
        document.getElementById('new-emp-dept')?.classList.add('invalid');
        document.getElementById('err-new-emp-dept')?.classList.add('visible');
        hasError = true;
      }
      if (!role) {
        document.getElementById('new-emp-role')?.classList.add('invalid');
        document.getElementById('err-new-emp-role')?.classList.add('visible');
        hasError = true;
      }

      if (hasError) return;

      const skillRows = document.querySelectorAll('#modal-skills-container .skill-input-row');
      const skillsToSave = [];
      skillRows.forEach(row => {
        const sName = row.querySelector('.skill-name-input')?.value.trim();
        const sLevel = parseInt(row.querySelector('.skill-level-input')?.value) || 80;
        if (sName) {
          skillsToSave.push({ name: sName, level: Math.min(100, Math.max(1, sLevel)) });
        }
      });

      const saveBtn = document.getElementById('btn-save-worker');
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.innerHTML = `<div class="spinner" style="width: 14px; height: 14px; border-width: 1.5px;"></div><span>Saving...</span>`;
      }

      try {
        if (editingWorkerId) {
          // --- EDIT MODE: PUT http://127.0.0.1:8000/employees/{id} ---
          const updatePayload = {
            name: name,
            department: dept,
            role: role
          };

          const putRes = await fetch(`${API_BASE_URL}/employees/${editingWorkerId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(updatePayload)
          });

          if (!putRes.ok) {
            const errData = await putRes.json().catch(() => ({}));
            throw new Error(errData.error || errData.detail || `Server responded with status ${putRes.status}`);
          }

          // Update local worker object
          const workerObj = rawEmployees.find(x => x.id === editingWorkerId || x.employee_id === editingWorkerId);
          if (workerObj) {
            workerObj.employee_id = empId;
            workerObj.rfid_uid = rfid;
            workerObj.name = name;
            workerObj.department = dept;
            workerObj.role = role;
            workerObj.availability = avail;
          }

          // Update skills
          rawEmployeeSkills = rawEmployeeSkills.filter(s => s.employee_id !== editingWorkerId && s.emp_id !== editingWorkerId);
          for (const sk of skillsToSave) {
            try {
              await fetch(`${API_BASE_URL}/employee_skills`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  employee_id: editingWorkerId,
                  skill_name: sk.name,
                  skill_level: sk.level
                })
              });
            } catch (skErr) {}

            rawEmployeeSkills.push({
              employee_id: editingWorkerId,
              skill_name: sk.name,
              skill_level: sk.level
            });
          }

          processAndRenderAll();
          closeAddWorkerModal();
          showToast('Worker profile updated successfully.');

          // If drawer was open for this worker, refresh it
          if (selectedWorkerId) {
            openWorkerDrawer(empId);
          }
        } else {
          // --- ADD NEW WORKER MODE ---
          let createdDbId = null;
          try {
            const empRes = await fetch(`${API_BASE_URL}/employees`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                employee_id: empId,
                rfid_uid: rfid,
                name: name,
                department: dept,
                role: role
              })
            });

            if (empRes.ok) {
              const updatedEmpsRes = await fetch(`${API_BASE_URL}/employees`);
              if (updatedEmpsRes.ok) {
                const allEmps = await updatedEmpsRes.json();
                const found = allEmps.find(x => x.employee_id === empId || x.name === name);
                if (found) createdDbId = found.id;
              }
            }
          } catch (netErr) {
            console.warn('API /employees unreachable. Saving in local state.', netErr);
          }

          if (!createdDbId) {
            createdDbId = (rawEmployees.length > 0 ? Math.max(...rawEmployees.map(x => x.id || 0)) : 0) + 1;
          }

          for (const sk of skillsToSave) {
            try {
              await fetch(`${API_BASE_URL}/employee_skills`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  employee_id: createdDbId,
                  skill_name: sk.name,
                  skill_level: sk.level
                })
              });
            } catch (skErr) {}
            
            rawEmployeeSkills.push({
              employee_id: createdDbId,
              skill_name: sk.name,
              skill_level: sk.level
            });
          }

          const newEmployeeObj = {
            id: createdDbId,
            employee_id: empId,
            rfid_uid: rfid,
            name: name,
            department: dept,
            role: role,
            availability: avail,
            workload: (avail === 'Available' ? 0 : (avail === 'On Leave' ? 0 : 50)),
            performance_score: null
          };

          rawEmployees.push(newEmployeeObj);

          processAndRenderAll();
          closeAddWorkerModal();
          showToast('Worker added successfully.');
        }
      } catch (err) {
        console.error('Error saving worker:', err);
        if (errorBanner && errorText) {
          errorText.textContent = `Error: ${err.message || 'Could not save worker. Please try again.'}`;
          errorBanner.classList.add('visible');
        }
        showToast(`Failed to ${editingWorkerId ? 'update' : 'add'} worker: ${err.message || 'Please check backend and try again.'}`, 'error');
      } finally {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.innerHTML = `<span>${editingWorkerId ? 'Save Changes' : 'Save Worker'}</span>`;
        }
      }
    }

    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      if (!container) return;

      const toast = document.createElement('div');
      const isError = type === 'error';
      toast.className = `toast-notification ${isError ? 'error' : ''}`;
      toast.innerHTML = `
        <div class="toast-icon">${isError ? '✕' : '✓'}</div>
        <span>${escapeHtml(message)}</span>
      `;
      container.appendChild(toast);

      setTimeout(() => toast.classList.add('show'), 50);
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }
  </script>

  <!-- ADD WORKER MODAL -->
  
  <!-- ADD MEMBER MODAL (Searchable Worker Picker) -->
  <div id="add-member-modal" class="modal-overlay" onclick="handleMemberModalBackdropClick(event)">
    <div class="modal-card" style="max-width: 820px; width: 92%;">
      <div class="modal-header">
        <div class="modal-title-group">
          <h2>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
            <span>Add Team Member</span>
          </h2>
          <p>Allocate a worker to <strong id="picker-target-project-name" style="color: var(--accent-steel);">Project</strong></p>
        </div>
        <button class="drawer-close-btn" onclick="closeAddMemberModal()" title="Close (Esc)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <div class="modal-body" style="padding: 16px 22px;">
        <div class="table-search-wrap" style="width: 100%; margin-bottom: 14px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" id="member-picker-search" class="table-search-input" placeholder="Search available workers by name, role, department, skill..." oninput="filterMemberPicker()" />
        </div>

        <div style="max-height: 380px; overflow-y: auto; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm);">
          <table class="data-table">
            <thead>
              <tr>
                <th style="min-width: 180px;">Worker</th>
                <th style="min-width: 150px;">Role & Dept</th>
                <th style="min-width: 180px;">Skills</th>
                <th style="min-width: 90px;">Status</th>
                <th style="min-width: 130px; text-align: right;">Action</th>
              </tr>
            </thead>
            <tbody id="member-picker-table-body">
              <!-- Populated dynamically -->
            </tbody>
          </table>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeAddMemberModal()">Cancel</button>
      </div>
    </div>
  </div>

  <div id="add-worker-modal" class="modal-overlay" onclick="handleModalBackdropClick(event)">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-title-group">
          <h2>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
            <span id="modal-worker-title">Add New Worker</span>
          </h2>
          <p id="modal-worker-sub">Register employee profile and configure skills matrix</p>
        </div>
        <button class="drawer-close-btn" onclick="closeAddWorkerModal()" title="Close (Esc)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <form id="add-worker-form" onsubmit="handleSaveWorker(event)">
        <div class="modal-body">
          <div id="modal-error-banner" class="modal-alert-error">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span id="modal-error-text">Failed to add worker. Please check the fields and try again.</span>
          </div>

          <div class="form-grid-2">
            <div class="form-field">
              <label for="new-emp-id">Employee ID <span class="req">*</span></label>
              <input type="text" id="new-emp-id" placeholder="e.g. EMP051" autocomplete="off" oninput="clearFieldError('new-emp-id')" />
              <span id="err-new-emp-id" class="field-error-msg">Employee ID is required.</span>
            </div>

            <div class="form-field">
              <label for="new-emp-rfid">RFID UID</label>
              <input type="text" id="new-emp-rfid" placeholder="e.g. RF051" autocomplete="off" />
            </div>
          </div>

          <div class="form-field">
            <label for="new-emp-name">Full Name <span class="req">*</span></label>
            <input type="text" id="new-emp-name" placeholder="e.g. Sarah Connor" autocomplete="off" oninput="clearFieldError('new-emp-name')" />
            <span id="err-new-emp-name" class="field-error-msg">Full Name is required.</span>
          </div>

          <div class="form-grid-2">
            <div class="form-field">
              <label for="new-emp-dept">Department <span class="req">*</span></label>
              <select id="new-emp-dept" onchange="clearFieldError('new-emp-dept')">
                <option value="">Select Department...</option>
                <option value="IT">IT</option>
                <option value="QA">QA</option>
                <option value="HR">HR</option>
                <option value="Design">Design</option>
                <option value="DevOps">DevOps</option>
                <option value="Core Engineering">Core Engineering</option>
                <option value="AI Research">AI Research</option>
                <option value="Infrastructure">Infrastructure</option>
                <option value="Client Applications">Client Applications</option>
                <option value="Data Platform">Data Platform</option>
                <option value="InfoSec">InfoSec</option>
              </select>
              <span id="err-new-emp-dept" class="field-error-msg">Department is required.</span>
            </div>

            <div class="form-field">
              <label for="new-emp-role">Role <span class="req">*</span></label>
              <input type="text" id="new-emp-role" placeholder="e.g. Senior DevOps Architect" autocomplete="off" oninput="clearFieldError('new-emp-role')" />
              <span id="err-new-emp-role" class="field-error-msg">Role is required.</span>
            </div>
          </div>

          <div class="form-field">
            <label for="new-emp-avail">Availability</label>
            <select id="new-emp-avail">
              <option value="Available">Available</option>
              <option value="On Project">On Project</option>
              <option value="On Leave">On Leave</option>
            </select>
          </div>

          <!-- Skills section -->
          <div style="border-top: 1px solid var(--border-subtle); padding-top: 14px; margin-top: 4px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
              <label style="font-size: 11px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.04em;">
                Skills & Proficiency (1-100)
              </label>
              <button type="button" class="btn btn-secondary" style="height: 26px; font-size: 11px; padding: 0 8px;" onclick="addSkillInputRow()">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>+ Add another skill</span>
              </button>
            </div>
            <div id="modal-skills-container"></div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="closeAddWorkerModal()">Cancel</button>
          <button type="submit" id="btn-save-worker" class="btn btn-primary" style="min-width: 120px; justify-content: center;">
            <span id="btn-save-worker-label">Save Worker</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- TOAST CONTAINER -->
  <div class="toast-container" id="toast-container"></div>

</body>
