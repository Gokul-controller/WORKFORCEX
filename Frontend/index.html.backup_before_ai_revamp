    function applyProjectsFilter() {
      const searchVal = (document.getElementById('projects-search-input')?.value || '').toLowerCase().trim();

      const filtered = processedProjects.filter(p => {
        if (currentProjectsFilter !== 'all' && p.statusKey !== currentProjectsFilter) return false;
        if (searchVal) {
          const matchName = p.name.toLowerCase().includes(searchVal);
          const matchCode = p.code.toLowerCase().includes(searchVal);
          const matchDesc = p.description.toLowerCase().includes(searchVal);
          if (!matchName && !matchCode && !matchDesc) return false;
        }
        return true;
      });

      renderProjectsMasterTable(filtered);
