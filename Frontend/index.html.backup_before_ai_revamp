<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WORKFORCE AI — Digital Twin & Skill Deployment</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  <style>
    /* ==========================================================================
       DESIGN SYSTEM & CSS VARIABLES
       ========================================================================== */
    :root {
      --bg-base: #090D16;
      --bg-surface: #0F1626;
      --bg-surface-elevated: #162035;
      --bg-card: #121A2D;
      --bg-card-hover: #18233C;
      --bg-input: #0B111E;

      --border-subtle: #1C2740;
      --border-strong: #2B3A5C;
      --border-accent: rgba(59, 130, 246, 0.35);

      --text-primary: #F1F5F9;
      --text-secondary: #94A3B8;
      --text-muted: #64748B;
      --text-dim: #475569;

      --accent-primary: #3B82F6;
      --accent-primary-hover: #2563EB;
      --accent-muted: #1D3557;
      --accent-steel: #60A5FA;
      --accent-glow: rgba(59, 130, 246, 0.15);

      --status-success: #10B981;
      --status-success-bg: rgba(16, 185, 129, 0.12);
      --status-success-border: rgba(16, 185, 129, 0.25);

      --status-warning: #F59E0B;
      --status-warning-bg: rgba(245, 158, 11, 0.12);
      --status-warning-border: rgba(245, 158, 11, 0.25);

      --status-danger: #EF4444;
      --status-danger-bg: rgba(239, 68, 68, 0.12);
      --status-danger-border: rgba(239, 68, 68, 0.25);

      --status-info: #38BDF8;
      --status-info-bg: rgba(56, 189, 248, 0.12);
      --status-info-border: rgba(56, 189, 248, 0.25);

      --status-gray: #94A3B8;
      --status-gray-bg: rgba(148, 163, 184, 0.12);
      --status-gray-border: rgba(148, 163, 184, 0.25);

      --status-purple: #A78BFA;
      --status-purple-bg: rgba(167, 139, 250, 0.12);
      --status-purple-border: rgba(167, 139, 250, 0.25);

      --sidebar-width: 260px;
      --topbar-height: 64px;
      --drawer-width: 480px;

      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;

      --radius-sm: 4px;
      --radius-md: 6px;
      --radius-lg: 8px;

      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.35);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -2px rgba(0, 0, 0, 0.3);
      --shadow-drawer: -8px 0 24px rgba(0, 0, 0, 0.6);
      --transition: all 0.15s ease-in-out;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-base);
      color: var(--text-primary);
      font-family: var(--font-sans);
      font-size: 13px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button, input, select, textarea {
      font-family: inherit;
      font-size: inherit;
      color: inherit;
    }

    .app-layout {
      display: flex;
      min-height: 100vh;
    }

    .sidebar {
      width: var(--sidebar-width);
      background-color: var(--bg-surface);
      border-right: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 100;
      user-select: none;
    }

    .brand {
      padding: 20px 20px 18px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .brand-header {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-icon {
      width: 28px;
      height: 28px;
      background: linear-gradient(135deg, #1E3A8A, #3B82F6);
      border: 1px solid var(--accent-steel);
      border-radius: var(--radius-sm);
      display: grid;
      place-items: center;
      color: #FFFFFF;
      box-shadow: 0 0 12px var(--accent-glow);
    }

    .brand-title {
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--text-primary);
      text-transform: uppercase;
      font-family: var(--font-mono);
    }

    .brand-subtitle {
      font-size: 9.5px;
      font-weight: 500;
      color: var(--text-muted);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      line-height: 1.3;
      padding-left: 38px;
    }

    .nav-section {
      flex: 1;
      padding: 18px 12px;
      display: flex;
      flex-direction: column;
      gap: 3px;
      overflow-y: auto;
    }

    .nav-section-title {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-dim);
      padding: 8px 10px 4px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 12px;
      border-radius: var(--radius-md);
      color: var(--text-secondary);
      font-weight: 500;
      font-size: 12.5px;
      transition: var(--transition);
      cursor: pointer;
      position: relative;
    }

    .nav-item:hover {
      background-color: var(--bg-surface-elevated);
      color: var(--text-primary);
    }

    .nav-item.active {
      background-color: var(--accent-muted);
      color: var(--accent-steel);
      font-weight: 600;
      border: 1px solid var(--border-accent);
    }

    .nav-item.active::before {
      content: '';
      position: absolute;
      left: -12px;
      top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 18px;
      background-color: var(--accent-primary);
      border-radius: 0 2px 2px 0;
    }

    .nav-icon {
      width: 17px;
      height: 17px;
      opacity: 0.85;
      flex-shrink: 0;
    }

    .nav-item.active .nav-icon {
      opacity: 1;
      stroke: var(--accent-steel);
    }

    .sidebar-footer {
      padding: 14px 12px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      gap: 4px;
      background-color: rgba(11, 17, 30, 0.4);
    }

    .system-status-badge {
      margin: 8px 6px 4px;
      padding: 8px 10px;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: var(--font-mono);
      font-size: 10.5px;
    }

    .system-status-indicator {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: var(--status-success);
      box-shadow: 0 0 6px var(--status-success);
      position: relative;
    }

    .pulse-dot.offline {
      background-color: var(--status-warning);
      box-shadow: 0 0 6px var(--status-warning);
    }

    .main-wrapper {
      flex: 1;
      margin-left: var(--sidebar-width);
      min-width: 0;
      display: flex;
      flex-direction: column;
    }

    .topbar {
      height: var(--topbar-height);
      background-color: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
      position: sticky;
      top: 0;
      z-index: 90;
    }

    .search-box {
      position: relative;
      width: 440px;
      max-width: 100%;
    }

    .search-box svg {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 15px;
      height: 15px;
      color: var(--text-muted);
      pointer-events: none;
    }

    .search-input {
      width: 100%;
      height: 36px;
      background-color: var(--bg-input);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 0 64px 0 36px;
      color: var(--text-primary);
      font-size: 12.5px;
      transition: var(--transition);
    }

    .search-input:focus {
      outline: none;
      border-color: var(--accent-primary);
      box-shadow: 0 0 0 2px var(--accent-glow);
      background-color: var(--bg-surface);
    }

    .search-input::placeholder {
      color: var(--text-dim);
    }

    .search-shortcut {
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      padding: 2px 6px;
      background-color: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      font-size: 10px;
      font-family: var(--font-mono);
      color: var(--text-muted);
      pointer-events: none;
    }

    .topbar-actions {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .date-display {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-secondary);
      background-color: var(--bg-card);
      padding: 6px 12px;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .date-display svg {
      width: 13px;
      height: 13px;
      color: var(--text-muted);
    }

    .icon-button {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-md);
      background-color: var(--bg-card);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      display: grid;
      place-items: center;
      cursor: pointer;
      position: relative;
      transition: var(--transition);
    }

    .icon-button:hover {
      background-color: var(--bg-surface-elevated);
      color: var(--text-primary);
      border-color: var(--border-strong);
    }

    .notification-dot {
      position: absolute;
      top: 7px;
      right: 7px;
      width: 6px;
      height: 6px;
      background-color: var(--accent-primary);
      border-radius: 50%;
      box-shadow: 0 0 4px var(--accent-primary);
    }

    .user-profile-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 10px 4px 4px;
      background-color: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: var(--transition);
    }

    .user-profile-btn:hover {
      border-color: var(--border-strong);
      background-color: var(--bg-surface-elevated);
    }

    .avatar {
      width: 28px;
      height: 28px;
      border-radius: var(--radius-sm);
      background: #1E293B;
      border: 1px solid var(--border-strong);
      display: grid;
      place-items: center;
      font-weight: 600;
      font-size: 11px;
      color: var(--accent-steel);
      font-family: var(--font-mono);
    }

    .user-meta {
      display: flex;
      flex-direction: column;
      text-align: left;
    }

    .user-name {
      font-size: 11.5px;
      font-weight: 600;
      color: var(--text-primary);
      line-height: 1.2;
    }

    .user-role {
      font-size: 9.5px;
      color: var(--text-muted);
      line-height: 1.2;
    }

    .content-area {
      flex: 1;
      padding: 24px 28px 40px;
      max-width: 1600px;
      width: 100%;
      margin: 0 auto;
    }

    .view-section {
      display: none;
      animation: fadeIn 0.2s ease-in-out;
    }

    .view-section.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(3px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .page-header {
      margin-bottom: 22px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 16px;
    }

    .header-text h1 {
      font-size: 20px;
      font-weight: 700;
      color: var(--text-primary);
      letter-spacing: -0.01em;
    }

    .header-text p {
      font-size: 12.5px;
      color: var(--text-secondary);
      margin-top: 3px;
    }

    .header-controls {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn {
      height: 32px;
      padding: 0 12px;
      border-radius: var(--radius-sm);
      font-size: 12px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      transition: var(--transition);
      border: 1px solid transparent;
      user-select: none;
    }

    .btn-secondary {
      background-color: var(--bg-surface-elevated);
      border-color: var(--border-subtle);
      color: var(--text-secondary);
    }

    .btn-secondary:hover {
      background-color: var(--bg-card-hover);
      color: var(--text-primary);
      border-color: var(--border-strong);
    }

    .btn-primary {
      background-color: var(--accent-primary);
      color: #FFFFFF;
    }

    .btn-primary:hover {
      background-color: var(--accent-primary-hover);
    }

    .btn-success {
      background-color: var(--status-success);
      color: #090D16;
      font-weight: 600;
    }

    .btn-success:disabled {
      opacity: 0.8;
      cursor: not-allowed;
    }

    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-bottom: 24px;
    }

    @media (min-width: 1400px) {
      .kpi-grid {
        grid-template-columns: repeat(8, 1fr);
      }
    }

    .kpi-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 12px 14px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
      transition: var(--transition);
    }

    .kpi-card:hover {
      border-color: var(--border-strong);
      transform: translateY(-1px);
      box-shadow: var(--shadow-sm);
    }

    .kpi-card::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: transparent;
    }

    .kpi-card.accent-blue::after { background: var(--accent-primary); }
    .kpi-card.accent-green::after { background: var(--status-success); }
    .kpi-card.accent-purple::after { background: #8B5CF6; }
    .kpi-card.accent-amber::after { background: var(--status-warning); }
    .kpi-card.accent-red::after { background: var(--status-danger); }
    .kpi-card.accent-sky::after { background: var(--status-info); }

    .kpi-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
    }

    .kpi-label {
      font-size: 10.5px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .kpi-icon-wrap {
      width: 20px;
      height: 20px;
      display: grid;
      place-items: center;
      color: var(--text-dim);
    }

    .kpi-icon-wrap svg {
      width: 14px;
      height: 14px;
    }

    .kpi-val-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
    }

    .kpi-value {
      font-size: 22px;
      font-weight: 700;
      font-family: var(--font-mono);
      color: var(--text-primary);
      line-height: 1.1;
    }

    .kpi-subtext {
      font-size: 10px;
      color: var(--text-dim);
      margin-top: 4px;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .badge-sub {
      display: inline-flex;
      align-items: center;
      padding: 1px 4px;
      border-radius: var(--radius-sm);
      font-size: 9.5px;
      font-family: var(--font-mono);
      font-weight: 600;
    }

    .badge-sub.green { color: var(--status-success); background: var(--status-success-bg); }
    .badge-sub.amber { color: var(--status-warning); background: var(--status-warning-bg); }
    .badge-sub.red { color: var(--status-danger); background: var(--status-danger-bg); }
    .badge-sub.blue { color: var(--accent-steel); background: rgba(59, 130, 246, 0.1); }
    .badge-sub.gray { color: var(--status-gray); background: var(--status-gray-bg); }
    .badge-sub.purple { color: var(--status-purple); background: var(--status-purple-bg); }

    .dashboard-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }

    @media (min-width: 1100px) {
      .dashboard-grid {
        grid-template-columns: 1.8fr 1fr;
      }
    }

    .panel {
      background-color: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .panel-header {
      padding: 14px 18px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background-color: rgba(15, 22, 38, 0.5);
    }

    .panel-title {
      font-size: 13.5px;
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .panel-title svg {
      width: 16px;
      height: 16px;
      color: var(--accent-steel);
    }

    .panel-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .panel-filter-tabs {
      display: flex;
      background-color: var(--bg-input);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 2px;
      gap: 2px;
    }

    .tab-btn {
      background: transparent;
      border: none;
      padding: 4px 10px;
      font-size: 11px;
      font-weight: 500;
      color: var(--text-muted);
      border-radius: 3px;
      cursor: pointer;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .tab-btn:hover {
      color: var(--text-primary);
    }

    .tab-btn.active {
      background-color: var(--bg-surface-elevated);
      color: var(--text-primary);
      font-weight: 600;
      box-shadow: var(--shadow-sm);
    }

    .tab-count-pill {
      padding: 1px 5px;
      border-radius: 10px;
      font-size: 9.5px;
      font-family: var(--font-mono);
      background: rgba(148, 163, 184, 0.15);
      color: var(--text-secondary);
    }

    .tab-btn.active .tab-count-pill {
      background: var(--accent-primary);
      color: #FFFFFF;
    }

    .projects-container {
      padding: 0;
      max-height: 540px;
      overflow-y: auto;
    }

    .project-table, .data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 12.5px;
    }

    .project-table th, .data-table th {
      background-color: var(--bg-surface);
      color: var(--text-muted);
      font-size: 10.5px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 11px 16px;
      border-bottom: 1px solid var(--border-subtle);
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .project-table td, .data-table td {
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-subtle);
      vertical-align: middle;
    }

    .project-table tbody tr, .data-table tbody tr {
      transition: var(--transition);
    }

    .project-table tbody tr:hover, .data-table tbody tr:hover {
      background-color: var(--bg-surface-elevated);
    }

    .project-meta {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .project-name {
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12.5px;
    }

    .project-id {
      font-size: 10px;
      font-family: var(--font-mono);
      color: var(--text-dim);
    }

    .project-desc-sub {
      font-size: 11px;
      color: var(--text-muted);
      max-width: 480px;
      line-height: 1.35;
      margin-top: 2px;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .progress-bar-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 140px;
    }

    .progress-track {
      flex: 1;
      height: 5px;
      background-color: var(--bg-surface-elevated);
      border-radius: 999px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background-color: var(--accent-primary);
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    .progress-fill.green { background-color: var(--status-success); }
    .progress-fill.amber { background-color: var(--status-warning); }
    .progress-fill.red { background-color: var(--status-danger); }
    .progress-fill.purple { background-color: var(--status-purple); }

    .progress-percent {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-secondary);
      min-width: 32px;
      text-align: right;
    }

    .team-badge-group {
      display: flex;
      align-items: center;
      gap: 5px;
      font-family: var(--font-mono);
      font-size: 11.5px;
      color: var(--text-secondary);
    }

