      tbody.innerHTML = workers.map((w, idx) => {
        const initials = w.name.split(' ').map(n => n[0]).join('').slice(0, 2);
        const checkinTime = w.statusKey === 'on_leave' ? '— (PTO)' : `08:${40 + (idx % 18)} AM`;
        
