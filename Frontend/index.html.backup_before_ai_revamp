          (w.currentProject && w.currentProject.toLowerCase() === proj.name.toLowerCase());
        if (isAlreadyInTeam) return false;

        if (query) {
          const matchName = (w.name || '').toLowerCase().includes(query);
          const matchId = (w.id || '').toLowerCase().includes(query);
          const matchRole = (w.role || '').toLowerCase().includes(query);
          const matchDept = (w.department || '').toLowerCase().includes(query);
          const matchSkills = (w.skills || []).some(s => (s.name || '').toLowerCase().includes(query));
          if (!matchName && !matchId && !matchRole && !matchDept && !matchSkills) return false;
        }
        return true;
      });

      const tbody = document.getElementById('member-picker-table-body');
      if (!tbody) return;

