    async function addMemberToProject(projectId, workerId) {
      const proj = processedProjects.find(p => p.id === projectId);
      const worker = processedWorkers.find(w => w.id === workerId || w.dbId === workerId);
      if (!proj || !worker) return;

      const targetEmpId = worker.dbId || worker.id;

      try {
        await fetch(`${API_BASE_URL}/projects/${projectId}/members`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ employee_id: targetEmpId })
        });
      } catch (err) {
        console.warn(`POST /projects/${projectId}/members endpoint error:`, err.message);
      }

      if (!projectTeams[projectId]) projectTeams[projectId] = [];
      if (!projectTeams[projectId].includes(worker.id)) {
        projectTeams[projectId].push(worker.id);
      }

      // Update worker status and current project
      worker.status = 'On Project';
      worker.statusKey = 'on_project';
      worker.currentProject = proj.name;
      if (!worker.workload || worker.workload < 30) worker.workload = 50;

      const rawEmp = rawEmployees.find(e => e.id === targetEmpId || e.employee_id === worker.id);
      if (rawEmp) {
        rawEmp.availability = 'On Project';
        rawEmp.current_project = proj.name;
      }

      renderProjectTeamMembers(projectId);
      renderWorkersTable(processedWorkers);
      renderProjectsMasterTable(processedProjects);
      renderDashboardFromData(processedWorkers, processedProjects);

      closeAddMemberModal();
      showToast(`Added ${worker.name} to ${proj.name}.`);
    }

    async function removeMemberFromProject(projectId, workerId) {
      const proj = processedProjects.find(p => p.id === projectId);
      const worker = processedWorkers.find(w => w.id === workerId || w.dbId === workerId);
      if (!proj || !worker) return;

      const confirmed = window.confirm(`Remove ${worker.name} from ${proj.name}?`);
      if (!confirmed) return;

      const targetEmpId = worker.dbId || worker.id;

      try {
        await fetch(`${API_BASE_URL}/projects/${projectId}/members/${targetEmpId}`, {
          method: 'DELETE'
        });
      } catch (err) {
        console.warn(`DELETE /projects/${projectId}/members/${targetEmpId} endpoint error:`, err.message);
      }

      if (projectTeams[projectId]) {
        projectTeams[projectId] = projectTeams[projectId].filter(id => id !== worker.id && id !== targetEmpId);
      }

      // Update worker status back to Available
      worker.status = 'Available';
      worker.statusKey = 'available';
      worker.currentProject = null;
      worker.workload = 0;

      const rawEmp = rawEmployees.find(e => e.id === targetEmpId || e.employee_id === worker.id);
      if (rawEmp) {
        rawEmp.availability = 'Available';
        rawEmp.current_project = null;
      }

      renderProjectTeamMembers(projectId);
      renderWorkersTable(processedWorkers);
      renderProjectsMasterTable(processedProjects);
      renderDashboardFromData(processedWorkers, processedProjects);

      showToast(`Removed ${worker.name} from project.`);
    }

