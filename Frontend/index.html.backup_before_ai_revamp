    function renderReportsView() {
      const totalWorkers = processedWorkers.length;
      let onProjectCount = 0;
      let availableCount = 0;
      let onLeaveCount = 0;
      let totalPerf = 0;
      let topPerformer = null;
      let maxPerf = -1;

      processedWorkers.forEach(w => {
        if (w.statusKey === 'on_project') onProjectCount++;
        else if (w.statusKey === 'available') availableCount++;
        else if (w.statusKey === 'on_leave') onLeaveCount++;

        totalPerf += (w.performance || 90);
        if ((w.performance || 0) > maxPerf) {
          maxPerf = w.performance;
          topPerformer = w;
        }
      });

      const utilizationPct = totalWorkers > 0 ? Math.round((onProjectCount / totalWorkers) * 100) : 0;
      const availPct = totalWorkers > 0 ? Math.round((availableCount / totalWorkers) * 100) : 0;
      const leavePct = totalWorkers > 0 ? Math.round((onLeaveCount / totalWorkers) * 100) : 0;
      const avgPerf = totalWorkers > 0 ? (totalPerf / totalWorkers).toFixed(1) : 92.0;

      const utilRateEl = document.getElementById('rep-utilization-rate');
      if (utilRateEl) utilRateEl.textContent = `${utilizationPct}%`;
      
      const barDep = document.getElementById('rep-util-bar-deployed');
      const barAvail = document.getElementById('rep-util-bar-avail');
      const barLeave = document.getElementById('rep-util-bar-leave');
      if (barDep) barDep.style.width = `${utilizationPct}%`;
      if (barAvail) barAvail.style.width = `${availPct}%`;
      if (barLeave) barLeave.style.width = `${leavePct}%`;

      const txtDep = document.getElementById('rep-util-text-deployed');
      const txtAvail = document.getElementById('rep-util-text-avail');
      const txtLeave = document.getElementById('rep-util-text-leave');
      if (txtDep) txtDep.textContent = `On Project: ${onProjectCount} (${utilizationPct}%)`;
      if (txtAvail) txtAvail.textContent = `Available: ${availableCount} (${availPct}%)`;
      if (txtLeave) txtLeave.textContent = `On Leave: ${onLeaveCount} (${leavePct}%)`;

      const skillCounts = {};
      rawEmployeeSkills.forEach(item => {
        const s = item.skill_name || item.skill || 'Skill';
        skillCounts[s] = (skillCounts[s] || 0) + 1;
      });

      if (Object.keys(skillCounts).length === 0) {
        processedWorkers.forEach(w => (w.skills || []).forEach(s => { skillCounts[s.name] = (skillCounts[s.name] || 0) + 1; }));
      }

      const sortedSkills = Object.entries(skillCounts).sort((a, b) => b[1] - a[1]).slice(0, 5);
      const skillsRepContainer = document.getElementById('rep-skills-container');
      if (skillsRepContainer) {
        skillsRepContainer.innerHTML = sortedSkills.map(([skill, count]) => {
          const pct = Math.min(100, Math.round((count / Math.max(1, totalWorkers)) * 100));
          return `
            <div class="report-bar-row">
              <div class="report-bar-label">
                <span style="font-weight: 500; color: var(--text-primary);">${escapeHtml(skill)}</span>
                <span style="font-family: var(--font-mono); color: var(--accent-steel);">${count} workers (${pct}%)</span>
              </div>
              <div class="report-bar-track">
                <div class="report-bar-fill" style="width: ${pct}%; background-color: var(--accent-primary);"></div>
              </div>
            </div>
          `;
        }).join('');
      }

      const totalProjects = processedProjects.length;
      animateCount('rep-total-projects', totalProjects);
      const projContainer = document.getElementById('rep-projects-breakdown');
      if (projContainer) {
        const statusMap = {
          'on-schedule': { label: 'On Schedule', color: 'var(--status-success)', count: processedProjects.filter(p => p.statusKey === 'on-schedule').length },
          'at-risk': { label: 'At Risk', color: 'var(--status-warning)', count: processedProjects.filter(p => p.statusKey === 'at-risk').length },
          'delayed': { label: 'Delayed', color: 'var(--status-danger)', count: processedProjects.filter(p => p.statusKey === 'delayed').length },
          'completed': { label: 'Completed', color: 'var(--status-info)', count: processedProjects.filter(p => p.statusKey === 'completed').length }
        };

        projContainer.innerHTML = Object.values(statusMap).map(st => {
          const pct = totalProjects > 0 ? Math.round((st.count / totalProjects) * 100) : 0;
          return `
            <div class="report-bar-row">
              <div class="report-bar-label">
                <span>${st.label}</span>
