    function filterProjectsList(filterKey, buttonEl) {
      currentProjectsFilter = filterKey;
      const tabs = document.querySelectorAll('#view-projects .panel-filter-tabs .tab-btn');
      tabs.forEach(btn => btn.classList.remove('active'));
      if (buttonEl) buttonEl.classList.add('active');
