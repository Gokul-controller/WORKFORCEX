    async function approveAssignment(taskId, empId, empName, score) {
      const btn = document.getElementById(`assign-btn-${empId}`);
      if (btn) {
        btn.innerHTML = `<div class="spinner" style="width: 12px; height: 12px; border-width: 1.5px;"></div><span>Saving...</span>`;
      }

      try {
        await fetch(`${API_BASE_URL}/assignments`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            task_id: taskId || 1,
            employee_id: empId,
            employee_name: empName,
            skill_match_score: score
          })
        });
      } catch (err) {
        console.warn('API POST /assignments offline. Storing in local state.');
      }

      const targetTask = processedTasks.find(t => t.id === taskId);
      if (targetTask) {
        targetTask.assignedName = empName;
        targetTask.assignedEmployeeId = empId;
        targetTask.status = 'In Progress';
        targetTask.statusKey = 'in_progress';
      }

      if (btn) {
        btn.className = 'btn btn-success';
        btn.disabled = true;
        btn.innerHTML = `<span>✓ Assigned</span>`;
      }
    }

    function applyAttendanceFilter() {
      const query = (document.getElementById('att-search-input')?.value || '').toLowerCase().trim();
      const statusFilter = document.getElementById('att-status-filter')?.value || 'all';

      const totalWorkers = processedWorkers.length;
      let presentCount = 0;
      let leaveCount = 0;

      processedWorkers.forEach(w => {
        if (w.statusKey === 'available' || w.statusKey === 'on_project') presentCount++;
        if (w.statusKey === 'on_leave') leaveCount++;
      });

      const absentCount = Math.max(0, totalWorkers - presentCount - leaveCount) || 1;
      const presentPct = totalWorkers > 0 ? Math.round((presentCount / totalWorkers) * 100) : 0;
      const absentPct = totalWorkers > 0 ? Math.round((absentCount / totalWorkers) * 100) : 0;

      animateCount('att-present-val', presentCount);
      animateCount('att-absent-val', absentCount);
      animateCount('att-leave-val', leaveCount);
      animateCount('att-total-val', totalWorkers);

      const pPct = document.getElementById('att-present-pct');
      const aPct = document.getElementById('att-absent-pct');
      if (pPct) pPct.textContent = `${presentPct}%`;
      if (aPct) aPct.textContent = `${absentPct}%`;

      const filtered = processedWorkers.filter((w, idx) => {
        let isPresent = w.statusKey === 'available' || w.statusKey === 'on_project';
        let isAbsent = idx === processedWorkers.length - 1;

        if (statusFilter === 'present' && !isPresent) return false;
        if (statusFilter === 'on_project' && w.statusKey !== 'on_project') return false;
        if (statusFilter === 'on_leave' && w.statusKey !== 'on_leave') return false;
        if (statusFilter === 'absent' && !isAbsent) return false;

        if (query) {
          const matchName = w.name.toLowerCase().includes(query);
          const matchId = w.id.toLowerCase().includes(query);
          const matchRole = w.role.toLowerCase().includes(query);
          if (!matchName && !matchId && !matchRole) return false;
        }
        return true;
      });

      renderAttendanceTable(filtered);
    }

    function renderAttendanceTable(workers) {
