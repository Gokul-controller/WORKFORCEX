    function populateWorkerDropdowns(workers) {
      const deptSelect = document.getElementById('worker-dept-filter');
      const roleSelect = document.getElementById('worker-role-filter');
      const skillSelect = document.getElementById('worker-skill-filter');

      if (!deptSelect || !roleSelect || !skillSelect) return;

      const depts = new Set();
      const roles = new Set();
      const skills = new Set();

      workers.forEach(w => {
        if (w.department) depts.add(w.department);
        if (w.role) roles.add(w.role);
        (w.skills || []).forEach(s => skills.add(s.name));
      });

      const currentDept = deptSelect.value;
      const currentRole = roleSelect.value;
      const currentSkill = skillSelect.value;

      deptSelect.innerHTML = `<option value="all">Department: All</option>` + Array.from(depts).sort().map(d => `<option value="${escapeHtml(d)}">${escapeHtml(d)}</option>`).join('');
      roleSelect.innerHTML = `<option value="all">Role: All</option>` + Array.from(roles).sort().map(r => `<option value="${escapeHtml(r)}">${escapeHtml(r)}</option>`).join('');
      skillSelect.innerHTML = `<option value="all">Skill: All</option>` + Array.from(skills).sort().map(s => `<option value="${escapeHtml(s)}">${escapeHtml(s)}</option>`).join('');

      deptSelect.value = currentDept || 'all';
      roleSelect.value = currentRole || 'all';
      skillSelect.value = currentSkill || 'all';
    }

    function applyWorkerFilters() {
      const query = (document.getElementById('workers-table-search')?.value || '').toLowerCase().trim();
      const statusFilter = document.getElementById('worker-status-filter')?.value || 'all';
      const deptFilter = document.getElementById('worker-dept-filter')?.value || 'all';
      const roleFilter = document.getElementById('worker-role-filter')?.value || 'all';
      const skillFilter = document.getElementById('worker-skill-filter')?.value || 'all';

      const filtered = processedWorkers.filter(worker => {
        if (statusFilter !== 'all' && worker.statusKey !== statusFilter) return false;
        if (deptFilter !== 'all' && worker.department !== deptFilter) return false;
        if (roleFilter !== 'all' && worker.role !== roleFilter) return false;
        if (skillFilter !== 'all' && !(worker.skills || []).some(s => s.name === skillFilter)) return false;

        if (query) {
          const matchName = worker.name.toLowerCase().includes(query);
          const matchId = worker.id.toLowerCase().includes(query);
          const matchRole = worker.role.toLowerCase().includes(query);
          const matchDept = worker.department.toLowerCase().includes(query);
          const matchProject = (worker.currentProject || '').toLowerCase().includes(query);
          const matchSkills = (worker.skills || []).some(s => s.name.toLowerCase().includes(query));
          if (!matchName && !matchId && !matchRole && !matchDept && !matchProject && !matchSkills) return false;
        }
        return true;
      });

      renderWorkersTable(filtered);
    }

    function resetWorkerFilters() {
      ['workers-table-search', 'worker-status-filter', 'worker-dept-filter', 'worker-role-filter', 'worker-skill-filter'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = (id === 'workers-table-search' ? '' : 'all');
      });
      applyWorkerFilters();
    }

