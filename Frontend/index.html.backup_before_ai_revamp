              </div>
              <div class="report-bar-track">
                <div class="report-bar-fill" style="width: ${pct}%; background-color: ${st.color};"></div>
              </div>
            </div>
          `;
        }).join('');
      }

      const avgPerfEl = document.getElementById('rep-avg-perf');
      if (avgPerfEl) avgPerfEl.textContent = avgPerf;

      const topPerfEl = document.getElementById('rep-top-performer');
      if (topPerfEl) topPerfEl.textContent = topPerformer ? `${topPerformer.name} (${topPerformer.performance})` : 'Gokul Raj S (98)';
      
      const perfBar = document.getElementById('rep-perf-bar');
