                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Approve & Assign</span>
                </button>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; font-size: 11px;">
              <div>
                <span style="color: var(--text-muted);">Status:</span>
                <span class="status-pill ${availability.toLowerCase().replace(/[\s-]/g, '_')}" style="margin-left: 6px;">${escapeHtml(availability)}</span>
              </div>
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="color: var(--text-muted);">Workload:</span>
                <div class="workload-track" style="flex: 1;"><div class="workload-bar-fill ${workload >= 80 ? 'critical' : 'optimal'}" style="width: ${workload}%;"></div></div>
                <span style="font-family: var(--font-mono); color: var(--text-secondary);">${workload}%</span>
              </div>
