      if (buttonEl) buttonEl.classList.add('active');
      renderDashboardProjectsTable(processedProjects);
    }

    function generateAndRenderAIInsights(workers, projects, availableCount, totalWorkers) {
      const container = document.getElementById('ai-insights-list');
      if (!container) return;

      const skillCounts = {};
      workers.forEach(e => {
        (e.skills || []).forEach(s => { skillCounts[s.name] = (skillCounts[s.name] || 0) + 1; });
      });

      let topSkill = 'Python';
      let topSkillCount = 0;
      for (const [skill, count] of Object.entries(skillCounts)) {
        if (count > topSkillCount) { topSkillCount = count; topSkill = skill; }
      }

      const matrixSkillEl = document.getElementById('matrix-top-skill');
      if (matrixSkillEl) matrixSkillEl.textContent = topSkillCount > 0 ? `${topSkill} (${topSkillCount})` : 'None';

      const insights = [];
      if (availableCount > 0) {
        insights.push({
          type: 'info',
          title: 'Specialist Availability',
          time: 'Live',
          desc: `<strong>${availableCount} verified employees</strong> currently available with skills ready for task dispatch.`,
          action: 'Deploy Specialists to Tasks →'
        });
      }

      const atRisk = projects.filter(p => p.statusKey === 'at-risk' || p.statusKey === 'delayed');
      if (atRisk.length > 0) {
        const target = atRisk[0];
        insights.push({
          type: 'alert-warning',
          title: `Resource Deficit: ${target.name.split(':')[0]}`,
          time: 'Priority',
          desc: `Progress is at <strong>${target.progress}%</strong> against deadline <code>${target.deadline}</code>. Recommendation: Allocate available workers to mitigate delay.`,
          action: 'Optimize Team Allocation →'
        });
      }

      if (insights.length === 0) {
        insights.push({
          type: 'info',
          title: 'Workforce Operations Nominal',
          time: 'Live',
          desc: `Workforce system is stable. All scheduled projects and resources are currently aligned.`,
          action: 'View All Projects →'
        });
      }

      container.innerHTML = insights.map(ins => `
        <div class="insight-card ${ins.type}">
          <div class="insight-top">
            <span class="insight-title">${ins.title}</span>
            <span class="insight-time">${ins.time}</span>
          </div>
          <p class="insight-desc">${ins.desc}</p>
          <div class="insight-action" onclick="navigateView('projects')">${ins.action}</div>
        </div>
      `).join('');
    }

    function renderDynamicActivityFeed() {
      const container = document.getElementById('recent-activity-list');
      if (!container) return;

      if (processedWorkers.length === 0) {
        container.innerHTML = `<div style="text-align: center; padding: 24px; color: var(--text-muted); font-size: 12px;">No recent activity recorded yet.</div>`;
        return;
      }

      const activities = [];
      const emps = processedWorkers.slice(0, 8);
      emps.forEach((w, idx) => {
        const timeStr = `0${8 + (idx % 3)}:${(10 + idx * 7) % 60 < 10 ? '0' : ''}${(10 + idx * 7) % 60}`;
        if (w.statusKey === 'on_project' && w.currentProject) {
          activities.push({ name: w.name, action: `Assigned to ${w.currentProject}`, time: timeStr, type: 'assigned', role: w.role });
        } else if (w.statusKey === 'on_leave') {
          activities.push({ name: w.name, action: 'Logged Leave', time: timeStr, type: 'leave', role: w.role });
        } else {
          activities.push({ name: w.name, action: 'Checked in', time: timeStr, type: 'checkin', role: w.role });
        }
      });

      renderActivityFeed(activities);
    }

    function renderActivityFeed(activities) {
      const container = document.getElementById('recent-activity-list');
      if (!container) return;

      container.innerHTML = activities.map(act => {
        const initials = act.name.split(' ').map(n => n[0]).join('').slice(0, 2);
