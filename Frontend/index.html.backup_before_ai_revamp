    function openProjectDetail(projectId) {
      const proj = processedProjects.find(p => p.id == projectId);
      if (!proj) return;

      selectedProjectId = proj.id;
      activeView = 'projects';

      // Update sidebar nav items
      const navLinks = document.querySelectorAll('.nav-section .nav-item');
      navLinks.forEach(link => {
        if (link.getAttribute('data-view') === 'projects') link.classList.add('active');
        else if (link.getAttribute('data-view')) link.classList.remove('active');
      });

      // Show projects view section
      document.querySelectorAll('.view-section').forEach(sec => sec.classList.remove('active'));
      const targetSec = document.getElementById('view-projects');
      if (targetSec) targetSec.classList.add('active');
      window.location.hash = 'projects';

      // Hide list subview, show detail subview
      const listSub = document.getElementById('projects-list-subview');
      const detailSub = document.getElementById('project-detail-subview');
      if (listSub) listSub.style.display = 'none';
      if (detailSub) detailSub.style.display = 'flex';

      document.getElementById('detail-proj-name').textContent = proj.name;
      document.getElementById('detail-proj-desc').textContent = proj.description;
      document.getElementById('detail-proj-id').textContent = proj.code;
      document.getElementById('detail-proj-progress').textContent = `${proj.progress}%`;
      document.getElementById('detail-proj-deadline').textContent = proj.deadline;

      const statusPill = document.getElementById('detail-proj-status');
      if (statusPill) {
        statusPill.textContent = proj.status;
        statusPill.className = `status-pill ${proj.statusKey}`;
      }

      const priorityPill = document.getElementById('detail-proj-priority');
      if (priorityPill) {
        priorityPill.textContent = proj.priority.toUpperCase();
        priorityPill.className = `priority-badge priority-${proj.priority.toLowerCase()}`;
      }

      const progressBar = document.getElementById('detail-proj-progress-bar');
      if (progressBar) {
        progressBar.style.width = `${proj.progress}%`;
        progressBar.className = 'progress-fill ' + (proj.progress >= 75 ? 'green' : (proj.progress >= 40 ? 'amber' : 'red'));
      }

      // Render Team Members
      renderProjectTeamMembers(projectId);

      // Render Sprint Tasks
      const tasksContainer = document.getElementById('detail-tasks-body');
      const tasksCount = document.getElementById('detail-tasks-count');
      const matchedTasks = processedTasks.filter(t => t.projectId === proj.id);
      
      if (tasksCount) tasksCount.textContent = `${matchedTasks.length} Tasks`;
      if (tasksContainer) {
        tasksContainer.innerHTML = matchedTasks.length === 0 
          ? `<tr><td colspan="4" style="text-align: center; padding: 20px; color: var(--text-muted);">No tasks scheduled yet.</td></tr>`
          : matchedTasks.map(t => {
              const initials = t.assignedName.split(' ').map(n => n[0]).join('').slice(0, 2);
              return `
                <tr>
                  <td style="font-weight: 500; color: var(--text-primary);">${escapeHtml(t.title)}</td>
                  <td>
                    <div class="task-assignee-badge">
                      <div class="task-assignee-avatar">${initials}</div>
                      <span>${escapeHtml(t.assignedName)}</span>
                    </div>
                  </td>
                  <td><span class="priority-badge priority-${t.priority.toLowerCase()}">${escapeHtml(t.priority)}</span></td>
                  <td><span class="status-pill ${t.statusKey.replace('_', '-')}">${escapeHtml(t.status)}</span></td>
                </tr>
              `;
            }).join('');
      }
    }

    function renderProjectTeamMembers(projectId) {
      const proj = processedProjects.find(p => p.id === projectId);
      if (!proj) return;

      const teamIds = projectTeams[projectId] || [];
