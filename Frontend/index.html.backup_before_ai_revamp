    async function confirmRemoveWorker(workerId) {
      const worker = processedWorkers.find(w => w.id === workerId || w.dbId === workerId);
      if (!worker) return;

      const confirmed = window.confirm(`Remove ${worker.name} from the system? This cannot be undone.`);
      if (!confirmed) return;

      const targetId = worker.dbId || worker.id;

      // Call backend DELETE endpoint: DELETE http://127.0.0.1:8000/employees/{id}
      try {
        await fetch(`${API_BASE_URL}/employees/${targetId}`, {
          method: 'DELETE'
        });
      } catch (err) {
        console.warn(`DELETE /employees/${targetId} request failed or backend not yet implemented:`, err.message);
      }

      // Remove from local in-memory collections
      rawEmployees = rawEmployees.filter(e => e.id !== targetId && e.employee_id !== worker.id);
      rawEmployeeSkills = rawEmployeeSkills.filter(s => s.employee_id !== targetId && s.emp_id !== targetId);

      for (const pid in projectTeams) {
        projectTeams[pid] = projectTeams[pid].filter(wid => wid !== worker.id && wid !== targetId);
      }

      // Close drawer, refresh table view & dashboard counts
      closeWorkerDrawer();
      processAndRenderAll();

      showToast('Worker removed successfully.');
    }

