    function onAiProjectSelected() {
      const projId = parseInt(document.getElementById('ai-project-select')?.value);
      const taskSelect = document.getElementById('ai-task-select');
      if (!taskSelect) return;

      if (!projId) {
        taskSelect.innerHTML = `<option value="">Choose a Task...</option>`;
        return;
      }

      const matchingTasks = processedTasks.filter(t => t.projectId === projId);
      taskSelect.innerHTML = `<option value="">Choose a Task...</option>` + 
        matchingTasks.map(t => `<option value="${t.id}">${escapeHtml(t.title)} (${escapeHtml(t.skill)})</option>`).join('');

      if (matchingTasks.length > 0) {
        taskSelect.value = matchingTasks[0].id;
        onAiTaskSelected();
      }
    }

    function onAiTaskSelected() {
      const taskId = parseInt(document.getElementById('ai-task-select')?.value);
      const task = processedTasks.find(t => t.id === taskId);
      if (!task) return;

      const skillInput = document.getElementById('ai-required-skill');
      const levelInput = document.getElementById('ai-required-level');

      if (skillInput) skillInput.value = task.skill;
      if (levelInput) levelInput.value = task.skillLevel || 80;
    }

    function toggleTeamSkill(skillName, element) {
      if (selectedTeamSkills.has(skillName)) {
        selectedTeamSkills.delete(skillName);
        element.classList.remove('selected');
      } else {
        selectedTeamSkills.add(skillName);
        element.classList.add('selected');
      }
    }

    async function runSingleTaskMatch() {
      const skill = document.getElementById('ai-required-skill')?.value || 'Python';
      const level = parseInt(document.getElementById('ai-required-level')?.value) || 80;
      const taskId = parseInt(document.getElementById('ai-task-select')?.value) || 1;

      const container = document.getElementById('ai-recommendations-container');
      const countEl = document.getElementById('ai-results-count');
      const titleEl = document.getElementById('ai-results-title');

      if (titleEl) titleEl.textContent = `AI Matches for Task: ${skill} (Lvl ${level})`;
      if (container) container.innerHTML = `<div class="loading-spinner-wrap"><div class="spinner"></div><span>Querying AI Neural Matcher...</span></div>`;

      let matches = [];

      try {
        const res = await fetch(`${API_BASE_URL}/match?skill=${encodeURIComponent(skill)}&level=${level}`);
        if (res.ok) {
          matches = await res.json();
        }
      } catch (e) {
        console.warn('API /match offline. Computing client-side match score.');
      }

      if (!matches || matches.length === 0) {
        matches = processedWorkers.map(w => {
          const empSkill = (w.skills || []).find(s => s.name.toLowerCase() === skill.toLowerCase());
          const skillLevel = empSkill ? empSkill.proficiency : Math.floor(Math.random() * 25) + 60;
          const availScore = w.statusKey === 'available' ? 100 : (w.statusKey === 'on_project' ? 50 : 20);
          const workloadScore = Math.max(0, 100 - w.workload);
          const overallScore = Math.round((skillLevel * 0.5) + (availScore * 0.3) + (workloadScore * 0.2));

          return {
            employee_id: w.dbId,
            employee_name: w.name,
            role: w.role,
            skill: skill,
            skill_level: skillLevel,
            availability: w.status,
            workload: w.workload,
            overall_score: overallScore
          };
        }).sort((a, b) => b.overall_score - a.overall_score);
      }

      if (countEl) countEl.textContent = `${matches.length} Candidates`;
      renderAiRecommendations(matches, taskId, skill);
    }

    async function runTeamFormation() {
      const skillsArray = Array.from(selectedTeamSkills);
      if (skillsArray.length === 0) {
        alert('Please select at least 1 or 2 skills from the list above.');
        return;
      }

      const container = document.getElementById('ai-recommendations-container');
      const countEl = document.getElementById('ai-results-count');
      const titleEl = document.getElementById('ai-results-title');

      if (titleEl) titleEl.textContent = `Autonomous Formed Team for ${skillsArray.join(', ')}`;
      if (container) container.innerHTML = `<div class="loading-spinner-wrap"><div class="spinner"></div><span>Forming balanced team across skill taxonomy...</span></div>`;

      let team = [];

      try {
        const res = await fetch(`${API_BASE_URL}/team-formation`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ required_skills: skillsArray })
        });
        if (res.ok) {
          team = await res.json();
        }
      } catch (e) {
        console.warn('API /team-formation offline. Computing team client-side.');
      }

      if (!team || team.length === 0) {
        team = skillsArray.map((sk, idx) => {
          const candidate = processedWorkers[idx % processedWorkers.length];
          return {
            employee_id: candidate.dbId,
            name: candidate.name,
            role: candidate.role,
            skill: sk,
            skill_level: 90,
            availability: candidate.status,
            workload: candidate.workload,
            overall_score: 92
          };
        });
      }

      if (countEl) countEl.textContent = `${team.length} Team Members`;
      renderAiRecommendations(team, 1, skillsArray.join('/'));
    }

    function renderAiRecommendations(candidates, taskId, targetSkill) {
