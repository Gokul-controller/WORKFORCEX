class ProjectMemberAdd(BaseModel):
    employee_id: Any

@app.post("/projects/{project_id}/members")
def add_project_member(project_id: int, member: ProjectMemberAdd):
    db = SessionLocal()
    emp = None
    try:
        emp = db.query(Employee).filter(Employee.id == int(member.employee_id)).first()
    except (ValueError, TypeError):
        pass
    if not emp:
        emp = db.query(Employee).filter(Employee.employee_id == str(member.employee_id)).first()

    proj = db.query(Project).filter(Project.id == project_id).first()
    if emp:
        emp.availability = "On Project"
        emp.current_project_id = project_id
        if proj:
            emp.current_project_name = proj.project_name
        db.commit()
    db.close()
    return {"message": "Member added to project"}

@app.delete("/projects/{project_id}/members/{employee_id}")
def remove_project_member(project_id: int, employee_id: str):
    db = SessionLocal()
    emp = None
    try:
        emp = db.query(Employee).filter(Employee.id == int(employee_id)).first()
    except (ValueError, TypeError):
        pass
    if not emp:
        emp = db.query(Employee).filter(Employee.employee_id == str(employee_id)).first()
    if emp:
        emp.availability = "Available"
        emp.current_project_id = None
        emp.current_project_name = None
        db.commit()
    db.close()
    return {"message": "Member removed from project"}

@app.delete("/projects/{project_id}")
def delete_project(project_id: int):
    db = SessionLocal()
    project = db.query(Project).filter(Project.id == project_id).first()
    if not project:
        db.close()
        return {"error": "Project not found"}
    
    # Unassign employees linked to this project
    employees = db.query(Employee).filter(Employee.current_project_id == project_id).all()
    for emp in employees:
        emp.current_project_id = None
        emp.current_project_name = None
        emp.availability = "Available"

    # Delete tasks linked to this project
    db.query(Task).filter(Task.project_id == project_id).delete()

    db.delete(project)
    db.commit()
    db.close()
    return {"message": "Project removed successfully"}


@app.get("/attendance/scan/{rfid_uid}")
def rfid_scan(rfid_uid: str):
    db = SessionLocal()
    employee = db.query(Employee).filter(Employee.rfid_uid == rfid_uid).first()
    db.close()
    if not employee:
        return {"found": False, "message": "Unknown RFID card"}
    return {
        "found": True,
        "employee_id": employee.employee_id,
        "name": employee.name,
        "role": employee.role,
        "department": employee.department,
        "availability": employee.availability,
        "current_project_id": employee.current_project_id,
        "current_project_name": employee.current_project_name
    }


