from database import Assignment

class AssignmentCreate(BaseModel):
    task_id: int
    employee_id: int
    employee_name: str
    skill_match_score: float

@app.get("/assignments")
def get_assignments():
    db = SessionLocal()
    data = db.query(Assignment).all()
    db.close()
